[Unit]
Description=AREDN Network Monitor
Documentation=https://github.com/gskuhlman/aredn-distributed-monitor
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/w0gsk/aredn-distributed-monitor
Environment="PATH=/home/w0gsk/aredn-distributed-monitor/venv/bin"
ExecStart=/home/w0gsk/aredn-distributed-monitor/venv/bin/python app.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
